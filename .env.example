# Noms des variables seulement. Posez les valeurs dans l'environnement du service, jamais dans un fichier commité.

# Google : clé JSON du compte de service, en base64 (ou chemin du fichier). Le compte doit être ÉDITEUR de la feuille.
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_SERVICE_ACCOUNT_FILE=
# L'identifiant de la feuille que l'équipe utilise vraiment (celui de l'URL qu'elle a ouverte).
SPREADSHEET_ID=

# Outil de réservation (iClosed) : clé API et TOUS les calendriers de vente, séparés par des virgules.
ICLOSED_API_KEY=
ICLOSED_EVENT_IDS=

# Enregistreur d'appels (Fathom) : une clé par compte, séparées par des virgules. Vide : ni liens ni No-Show.
FATHOM_API_KEYS=
# Appels à partir de cette date (AAAA-MM-JJ) sans aucun enregistrement = No-Show. Vide : jamais.
ABSENT_IF_NO_RECORDING_FROM=

# CRM : none, json, http, ou le chemin d'un module .js (voir references/03-crm.md).
CRM_ADAPTER=
CRM_JSON_FILE=
CRM_HTTP_URL=
CRM_HTTP_TOKEN=

# Vocabulaire de la feuille, de l'équipe et du CRM (défaut : ./config.json, sinon les valeurs par défaut).
SALES_SHEET_CONFIG=

# Alerte quand le service échoue plusieurs passes de suite (webhook Slack ou tout ce qui accepte {"text": "..."}).
ALERT_WEBHOOK_URL=
ALERT_AFTER_FAILURES=

# Réglages facultatifs
SYNC_SINCE=
LOOKBACK_DAYS=
POLL_SECONDS=
OUTCOME_MINUTES=
OUTCOME_WAIT_HOURS=
SHEET_TIME_ZONE=
PORT=
